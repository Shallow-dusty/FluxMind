# LLM API Configuration
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=DeepInfra/DeepSeek-V3.2

# API access control for /query
FLUXMIND_API_TOKEN=
MAX_UPLOAD_SIZE_MB=50

# Optional local API-key lifecycle registry.
# none = keep using only FLUXMIND_API_TOKEN; sqlite = allow hashed local keys
# managed by scripts/api_key_registry.py. Do not commit generated tokens.
FLUXMIND_API_KEY_REGISTRY_BACKEND=none
FLUXMIND_API_KEY_REGISTRY_FILE=metadata/api_keys.sqlite3

# Optional local product registry for users/workspaces/RBAC/quotas/billing attribution.
# none = disabled; sqlite = no-secret local ledger managed by scripts/product_registry.py.
# This is not an external identity provider or payment processor.
FLUXMIND_PRODUCT_REGISTRY_BACKEND=none
FLUXMIND_PRODUCT_REGISTRY_FILE=metadata/product_registry.sqlite3
FLUXMIND_IDENTITY_PROVIDER=none
FLUXMIND_QUOTA_STORE_BACKEND=none
FLUXMIND_BILLING_PROVIDER=none
FLUXMIND_BILLING_ATTRIBUTION_ENABLED=false
IDENTITY_QUOTAS_BILLING_ENABLED=false
FLUXMIND_PRODUCT_QUOTA_GUARD_ENABLED=false
FLUXMIND_PRODUCT_QUOTA_METRIC=requests
FLUXMIND_PRODUCT_RBAC_GUARD_ENABLED=false

# Embedding (local by default, no config needed)
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional no-key local CrossEncoder reranker.
# Leave empty to use the deterministic BM25-lite reranker only.
# Set to an existing local path; FluxMind does not download reranker models at runtime.
RERANKER_MODEL=

# Code execution backend.
# local = current child-process development provider.
# docker = local Docker sandbox backend for Python/Octave job execution.
CODE_EXECUTION_BACKEND=local
# Legacy fallback for Python jobs; prefer the language-specific image variables.
DOCKER_EXECUTION_IMAGE=python:3.11-slim
DOCKER_PYTHON_EXECUTION_IMAGE=python:3.11-slim
DOCKER_OCTAVE_EXECUTION_IMAGE=gnuoctave/octave:latest
# /jobs/code/*-docker routes require CODE_EXECUTION_BACKEND=docker and return 409 otherwise.
# Explicit smoke after Docker is available:
# CODE_EXECUTION_BACKEND=docker python scripts/docker_execution_smoke.py --language all
# Optional one-off image override for smoke only:
# python scripts/docker_execution_smoke.py --language octave --octave-image gnuoctave/octave:latest

# External provider activation.
# IMAGE_PROVIDER_BACKEND=openai enables real OpenAI image generation when an
# OpenAI image/API key is present. Hosted execution, MATLAB, and quota/cost guard
# settings remain opt-in until their matching external accounts and boundaries
# are deliberately configured and verified.
EXTERNAL_PROVIDERS_ENABLED=false
IMAGE_PROVIDER_BACKEND=local-mock
IMAGE_PROVIDER_API_CONFIGURED=false
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=auto
OPENAI_IMAGE_OUTPUT_FORMAT=png
OPENAI_IMAGE_TIMEOUT_S=120
HOSTED_EXECUTION_BACKEND=none
HOSTED_EXECUTION_CONFIGURED=false
MATLAB_BACKEND=none
MATLAB_LICENSE_CONFIGURED=false
PROVIDER_QUOTA_GUARD_ENABLED=false

# Durable storage readiness.
# local = current no-key JSON/SQLite/filesystem metadata and artifact storage.
# postgres/s3-compatible backends require explicit credentials and are only
# reported as readiness until storage migration is deliberately activated.
METADATA_STORAGE_BACKEND=local
DATABASE_URL=
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=

# Distributed worker/job-store readiness.
# local = current no-key SQLite/JSONL durable queue.
# postgres/redis/external require an explicit store URL and queue name; FluxMind
# reports readiness without exposing the URL and does not activate migration by
# configuration alone.
DISTRIBUTED_JOB_STORE_BACKEND=local
DISTRIBUTED_JOB_STORE_URL=
DISTRIBUTED_JOB_QUEUE_NAME=fluxmind-jobs

# Optional no-secret query cost estimates for admin views.
# Rates are USD per 1M tokens for the configured provider/model. This does not
# connect FluxMind to billing and remains disabled when both rates are 0.
QUERY_COST_PROVIDER=
QUERY_COST_PROMPT_USD_PER_1M=0
QUERY_COST_COMPLETION_USD_PER_1M=0

# Production note for China-hosted servers such as Trace-Twin:
# avoid depending on direct Docker Hub/GHCR pulls during runtime checks.
# Build deploy/docker/octave-trixie-slim.Dockerfile locally on the host and use:
# CODE_EXECUTION_BACKEND=docker
# DOCKER_PYTHON_EXECUTION_IMAGE=m.daocloud.io/docker.io/library/python:3.11-slim
# DOCKER_OCTAVE_EXECUTION_IMAGE=fluxmind/octave:trixie-slim
