# FluxMind runtime config template. Copy to .env (gitignored) and fill secrets.
# See DEVELOPMENT.md for the full config/conventions reference.

# === LLM API (RAG generation) — 中转别名"烁" (elysiver) ===
# 主力 deepseek-v4-pro (质量严谨, ~18s); 辅助 deepseek-v4-flash (小任务/辅助/最终兜底, ~13s)
LLM_BASE_URL=https://elysiver.h-e.top/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=deepseek-v4-pro
LLM_FALLBACK_MODEL=deepseek-v4-flash

# API access control for /query
FLUXMIND_API_TOKEN=
MAX_UPLOAD_SIZE_MB=50

# Embedding (local by default, no config needed)
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional local CrossEncoder reranker (leave empty for deterministic BM25-lite only)
RERANKER_MODEL=

# Code execution backend: local (dev child-process) or docker (sandbox)
CODE_EXECUTION_BACKEND=local
DOCKER_PYTHON_EXECUTION_IMAGE=python:3.11-slim
DOCKER_OCTAVE_EXECUTION_IMAGE=gnuoctave/octave:latest

# === Image generation (huyunapi relay, gpt-image-2) ===
# send_output_format=false: some relays hang on the output_format param.
# quality=low (~30s); raise to medium/high for better quality (slower).
IMAGE_PROVIDER_BACKEND=local-mock
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_OUTPUT_FORMAT=png
OPENAI_IMAGE_SEND_OUTPUT_FORMAT=false
OPENAI_IMAGE_TIMEOUT_S=180

# --- Legacy/frozen readiness (defaults are fine, no need to configure) ---
# Optional local registries / readiness surfaces retained from the prior
# enterprise-grade design (now frozen; see DEVELOPMENT.md §8). Leave at defaults
# unless you intentionally activate one.
FLUXMIND_API_KEY_REGISTRY_BACKEND=none
FLUXMIND_PRODUCT_REGISTRY_BACKEND=none
FLUXMIND_PRODUCT_QUOTA_GUARD_ENABLED=false
FLUXMIND_PRODUCT_RBAC_GUARD_ENABLED=false
HOSTED_EXECUTION_BACKEND=none
MATLAB_BACKEND=none
PROVIDER_QUOTA_GUARD_ENABLED=false
METADATA_STORAGE_BACKEND=local
DISTRIBUTED_JOB_STORE_BACKEND=local

# Production note for China-hosted servers (Trace-Twin):
# avoid direct Docker Hub/GHCR pulls during runtime; build octave image locally
# and use a mirror for python:
#   CODE_EXECUTION_BACKEND=docker
#   DOCKER_PYTHON_EXECUTION_IMAGE=m.daocloud.io/docker.io/library/python:3.11-slim
#   DOCKER_OCTAVE_EXECUTION_IMAGE=fluxmind/octave:trixie-slim